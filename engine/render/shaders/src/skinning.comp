#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// @DX11_SSBO_SPLIT：DX11 compute 消费方约定 读 SSBO→SRV t{16+slot}、写 SSBO→UAV u{slot}
//   （见 dx11_rhi_device.cpp DispatchCompute：readonly→CSSetShaderResources(16+slot)、
//   writable→CSSetUnorderedAccessViews(slot)）。缺此标注时 spirv-cross 会把写 SSBO(dst,
//   binding 1) 映射为 UAV u17(=16+1)，而设备在 u1 绑定 → 写入丢弃、dst 全 0。
//   无 image/sampler，故不需 @COMPUTE_RESOURCE_REMAP；GL SSBO 直接用 binding 0..5。

// P2: 单次 Dispatch 蒙皮 — 通过 InstanceInfo SSBO 区分各实例

struct SrcVertex {
    vec4 pos_bw0;       // xyz = position, w = bone_weight[0]
    vec4 norm_bw1;      // xyz = normal,   w = bone_weight[1]
    vec4 tan_bw2;       // xyz = tangent,  w = bone_weight[2]
    vec4 joints_bw3;    // x/y/z/w = bone_index[0..3] (as float)
};

struct DstVertex {
    vec4 pos;           // xyz = skinned position, w = 1.0
    vec4 normal;        // xyz = skinned normal,   w = 0.0
    vec4 tangent;       // xyz = skinned tangent,  w = 0.0
};

// 布局全部改为 uint（不再用 vec4 morph_weights 内联 4 权重），使 GLSL std430 / 手写
// WGSL / C++ InstanceInfoGPU 三处 48B/16B 对齐逐字节一致；morph 权重改存独立 SSBO
// (binding 5) 以解除 4-target 硬上限。前 4 个非 morph 字段偏移保持不变，非 morph 实体行为不变。
struct InstanceInfo {
    uint vertex_start;        // 本实例在全局 src_vertices 中的起始偏移
    uint vertex_count;        // 本实例的顶点数
    uint bone_offset;         // 本实例在 bone_matrices 中的起始索引
    uint morph_target_count;  // morph target 数量（无上限；0 = 无 morph）
    uint morph_delta_offset;  // 本实例在 morph_deltas 中的起始 vec4 索引
    uint morph_weight_offset; // 本实例在 morph_weights 中的起始 float 索引
    uint _pad0; uint _pad1;
    uint _pad2; uint _pad3; uint _pad4; uint _pad5; // 48 bytes / 16B aligned
};

layout(std430, binding = 0) readonly buffer SrcBuf  { SrcVertex src_vertices[]; };
layout(std430, binding = 1) writeonly buffer DstBuf { DstVertex dst_vertices[]; };
layout(std430, binding = 2) readonly buffer BoneBuf { mat4 bone_matrices[]; };
layout(std430, binding = 3) readonly buffer MorphBuf { vec4 morph_deltas[]; };
layout(std430, binding = 4) readonly buffer InstBuf { InstanceInfo instances[]; };
layout(std430, binding = 5) readonly buffer MorphWBuf { float morph_weights[]; };

// 16B-aligned push block: each scalar member explicitly padded to a 16-byte
// slot so the layout matches the native staging convention (SetComputeUniformInt
// accumulates at 16B-per-call offsets: total@0, instance@16) AND the hand-written
// WGSL `@align(16)` struct. Keeps GL/VK/DX11/WebGPU in lockstep — see
// gpu_skinning.cpp kSkinningComputeWGSL.
layout(push_constant) uniform PC {
    uint total_vertices;    // offset 0  : 所有实例的总顶点数
    uint _pad0; uint _pad1; uint _pad2;
    uint instance_count;    // offset 16 : 实例数
} params;

// 二分查找当前顶点所属的实例
uint findInstance(uint gid) {
    uint lo = 0u, hi = params.instance_count;
    while (lo < hi) {
        uint mid = (lo + hi) / 2u;
        if (instances[mid].vertex_start + instances[mid].vertex_count <= gid)
            lo = mid + 1u;
        else
            hi = mid;
    }
    return lo;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.total_vertices) return;

    uint inst_id = findInstance(gid);
    if (inst_id >= params.instance_count) return;
    InstanceInfo inst = instances[inst_id];
    uint local_vid = gid - inst.vertex_start;

    SrcVertex src = src_vertices[gid];
    vec3 pos     = src.pos_bw0.xyz;
    vec3 normal  = src.norm_bw1.xyz;
    vec3 tangent = src.tan_bw2.xyz;

    // Morph target blending (无上限：权重从 morph_weights SSBO 按 offset 逐个读取)
    if (inst.morph_target_count > 0u) {
        uint mbase = inst.morph_delta_offset;
        uint wbase = inst.morph_weight_offset;
        for (uint m = 0u; m < inst.morph_target_count; ++m) {
            float w = morph_weights[wbase + m];
            if (abs(w) > 0.001) {
                pos += morph_deltas[mbase + m * inst.vertex_count + local_vid].xyz * w;
            }
        }
    }

    // 骨骼蒙皮
    float bw0 = src.pos_bw0.w, bw1 = src.norm_bw1.w, bw2 = src.tan_bw2.w;
    float bw3 = 1.0 - bw0 - bw1 - bw2;
    int bi0 = int(src.joints_bw3.x), bi1 = int(src.joints_bw3.y);
    int bi2 = int(src.joints_bw3.z), bi3 = int(src.joints_bw3.w);
    uint bb = inst.bone_offset;

    mat4 sm = bone_matrices[bb + bi0] * bw0 + bone_matrices[bb + bi1] * bw1
            + bone_matrices[bb + bi2] * bw2 + bone_matrices[bb + bi3] * bw3;

    // 写入蒙皮后顶点
    dst_vertices[gid].pos     = vec4((sm * vec4(pos, 1.0)).xyz, 1.0);
    mat3 nm = mat3(sm);
    dst_vertices[gid].normal  = vec4(normalize(nm * normal), 0.0);
    dst_vertices[gid].tangent = vec4(normalize(nm * tangent), 0.0);
}
