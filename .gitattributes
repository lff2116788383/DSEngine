# Normalize line endings in the repository (store as LF) and let Git manage
# working-tree EOL. Source files are UTF-8; keep them consistent across tools.
* text=auto

# Source / text
*.c      text
*.cc     text
*.cpp    text
*.cxx    text
*.h      text
*.hpp    text
*.hxx    text
*.inl    text
*.glsl   text
*.comp   text
*.vert   text
*.frag   text
*.cmake  text
*.txt    text
*.md     text
*.json   text
*.yml    text
*.yaml   text

# Binary assets (never touch EOL / never diff as text)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.tga    binary
*.ico    binary
*.dds    binary
*.ktx    binary
*.hdr    binary
*.exr    binary
*.ttf    binary
*.otf    binary
*.wav    binary
*.mp3    binary
*.ogg    binary
*.fbx    binary
*.glb    binary
*.gltf   binary
*.bin    binary
*.zip    binary
*.7z     binary
*.dll    binary
*.lib    binary
*.pdb    binary
*.exe    binary
